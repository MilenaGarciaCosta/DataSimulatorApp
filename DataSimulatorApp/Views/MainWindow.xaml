<Window x:Class="DataSimulatorApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DataSimulatorApp.ViewModels"
        xmlns:views="clr-namespace:DataSimulatorApp.Views"
        Title="CrystalMind Mission Control"
        Height="700"
        Width="1200">

    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:CreateSampleViewModel}">
            <views:CreateSampleView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SampleListViewModel}">
            <views:SampleListView/>
        </DataTemplate>

    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU -->

        <Border Grid.Column="0"
                Background="#20232A">

            <StackPanel Margin="20">

                <TextBlock Text="CrystalMind"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0 0 0 40"/>

                <Button Content="New Sample"
                        Height="40"
                        Margin="0 0 0 10"
                        Command="{Binding ShowCreateSampleCommand}"/>

                <Button Content="Consult Samples"
                        Height="40"
                        Command="{Binding ShowSampleListCommand}"/>

            </StackPanel>

        </Border>

        <!-- CONTENT -->

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}" />

    </Grid>

</Window>