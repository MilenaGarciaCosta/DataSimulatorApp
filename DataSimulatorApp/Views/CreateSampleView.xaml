<UserControl x:Class="DataSimulatorApp.Views.CreateSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>

        <StackPanel Margin="30">

            <TextBlock Text="Register Sample"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <TextBlock Text="Sample Code"/>
            <TextBox Text="{Binding Sample.SampleCode}"
                     Margin="0 5 0 15"/>

            <TextBlock Text="Protein Name"/>
            <TextBox Text="{Binding Sample.ProteinName}"
                     Margin="0 5 0 15"/>

            <TextBlock Text="Capture Date"/>
            <DatePicker SelectedDate="{Binding Sample.CaptureDate}"
                        Margin="0 5 0 15"/>

            <TextBlock Text="Incubation Period"/>
            <TextBox Text="{Binding Sample.IncubationPeriod}"
                     Margin="0 5 0 15"/>

            <TextBlock Text="Gravity Level"/>
            <TextBox Text="{Binding Sample.GravityLevel}"
                     Margin="0 5 0 15"/>

            <TextBlock Text="Temperature"/>
            <TextBox Text="{Binding Sample.Temperature}"
                     Margin="0 5 0 15"/>

            <TextBlock Text="Mechanical Vibration"/>
            <TextBox Text="{Binding Sample.MechanicalVibration}"
                     Margin="0 5 0 15"/>

            <TextBlock Text="Crystal Image"/>

            <Button Content="Select Image"
                    Width="150"
                    Margin="0 10 0 15"/>

            <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Height="250">

                <Image Stretch="Uniform"/>

            </Border>

            <Button Content="Register Sample"
                    Width="200"
                    Height="40"
                    Margin="0 20 0 0"
                    Command="{Binding SaveCommand}"/>

        </StackPanel>

    </ScrollViewer>

</UserControl>