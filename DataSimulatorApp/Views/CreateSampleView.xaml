<UserControl x:Class="DataSimulatorApp.Views.CreateSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Color Palette -->
        <Color x:Key="BgDeepColor">#FF0D1117</Color>
        <Color x:Key="BgSurfaceColor">#FF161B22</Color>
        <Color x:Key="BgElevatedColor">#FF1C2128</Color>
        <Color x:Key="BorderSubtleColor">#FF30363D</Color>
        <Color x:Key="AccentBlueColor">#FF58A6FF</Color>
        <Color x:Key="TextPrimaryColor">#FFE6EDF3</Color>
        <Color x:Key="TextMutedColor">#FF8B949E</Color>

        <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}"/>
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}"/>
        <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

        <!-- TextBox Style -->
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10 8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#FF58A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker Style -->
        <Style x:Key="FieldDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 0 0 5"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="#FF0D1117"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF79B8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF388BFD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A58A6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3358A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource BgDeepBrush}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32 28 32 40"
                    MaxWidth="560">

            <!-- Header -->
            <StackPanel Margin="0 0 0 28">
                <TextBlock Text="REGISTER SAMPLE"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlueBrush}"
                           Margin="0 0 0 6"/>
                <TextBlock Text="New Expedition Sample"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Rectangle Height="1"
                           Fill="{StaticResource BorderSubtleBrush}"
                           Margin="0 16 0 0"/>
            </StackPanel>

            <!-- Section: Identification -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0 0 0 16"
                    Padding="20">
                <StackPanel>
                    <!-- Section accent bar + label -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0 0 0 16">
                        <Rectangle Width="3" Height="14"
                                   Fill="{StaticResource AccentBlueBrush}"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Center"
                                   Margin="0 0 8 0"/>
                        <TextBlock Text="IDENTIFICATION"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="SAMPLE CODE"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Sample.SampleCode}"
                             Style="{StaticResource FieldTextBoxStyle}"
                             Margin="0 0 0 16"/>

                    <TextBlock Text="PROTEIN NAME"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Sample.ProteinName}"
                             Style="{StaticResource FieldTextBoxStyle}"
                             Margin="0 0 0 0"/>
                </StackPanel>
            </Border>

            <!-- Section: Collection -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0 0 0 16"
                    Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0 0 0 16">
                        <Rectangle Width="3" Height="14"
                                   Fill="{StaticResource AccentBlueBrush}"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Center"
                                   Margin="0 0 8 0"/>
                        <TextBlock Text="COLLECTION"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="CAPTURE DATE"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding Sample.CaptureDate}"
                                Style="{StaticResource FieldDatePickerStyle}"
                                Margin="0 0 0 0"/>
                </StackPanel>
            </Border>

            <!-- Section: Environmental Conditions -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0 0 0 16"
                    Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0 0 0 16">
                        <Rectangle Width="3" Height="14"
                                   Fill="{StaticResource AccentBlueBrush}"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Center"
                                   Margin="0 0 8 0"/>
                        <TextBlock Text="ENVIRONMENTAL CONDITIONS"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Two-column row: Gravity + Temperature -->
                    <Grid Margin="0 0 0 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GRAVITY LEVEL"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Sample.GravityLevel}"
                                     Style="{StaticResource FieldTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TEMPERATURE"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding Sample.Temperature}"
                                     Style="{StaticResource FieldTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="MECHANICAL VIBRATION"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Sample.MechanicalVibration}"
                             Style="{StaticResource FieldTextBoxStyle}"/>
                </StackPanel>
            </Border>

            <!-- Section: Sample Image -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0 0 0 28"
                    Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0 0 0 16">
                        <Rectangle Width="3" Height="14"
                                   Fill="{StaticResource AccentBlueBrush}"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Center"
                                   Margin="0 0 8 0"/>
                        <TextBlock Text="SAMPLE IMAGE"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Choose Image File"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="160"
                            Height="34"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Margin="0 0 0 12"
                            Command="{Binding SelectImageCommand}"/>

                    <TextBlock Text="{Binding SelectedImagePath}"
                               TextWrapping="Wrap"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0 0 0 12"/>

                    <!-- Image Preview -->
                    <Border Background="{StaticResource BgElevatedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Height="240">
                        <Image Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               Margin="8"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Submit Button -->
            <Button Content="Register Sample"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="200"
                    Height="40"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveCommand}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
