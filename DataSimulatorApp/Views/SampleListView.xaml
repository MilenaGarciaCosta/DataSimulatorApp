<UserControl x:Class="DataSimulatorApp.Views.SampleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="BgDeepBrush"      Color="#FF0D1117"/>
        <SolidColorBrush x:Key="BgSurfaceBrush"   Color="#FF161B22"/>
        <SolidColorBrush x:Key="BgElevatedBrush"  Color="#FF1C2128"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FF30363D"/>
        <SolidColorBrush x:Key="AccentBlueBrush"  Color="#FF58A6FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE6EDF3"/>
        <SolidColorBrush x:Key="TextMutedBrush"   Color="#FF8B949E"/>
        <SolidColorBrush x:Key="RowHoverBrush"    Color="#FF1C2128"/>
        <SolidColorBrush x:Key="RowAltBrush"      Color="#FF13181F"/>

        <!-- Refresh Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14 0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A58A6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3358A6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Column Header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12 10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Cell -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A58A6FF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Row -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A58A6FF"/>
                </Trigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource RowAltBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid itself -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAltBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDeepBrush}"
          Margin="32 28 32 32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0 0 0 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="SAMPLES"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlueBrush}"/>
                <TextBlock Text="Registered Samples"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0 4 0 0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- Divider -->
        <Rectangle Grid.Row="0"
                   Height="1"
                   Fill="{StaticResource BorderSubtleBrush}"
                   VerticalAlignment="Bottom"/>

        <!-- DataGrid -->
        <Border Grid.Row="1"
                Margin="0 20 0 0"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Samples}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      AlternationCount="2"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SAMPLE ID"
                                        Binding="{Binding SampleId}"
                                        Width="80"/>
                    <DataGridTextColumn Header="PROTEIN"
                                        Binding="{Binding ProteinName}"
                                        Width="150"/>
                    <DataGridTextColumn Header="STATUS"
                                        Binding="{Binding Status}"
                                        Width="100"/>
                    <DataGridTextColumn Header="CLASSIFICATION"
                                        Binding="{Binding Classification}"
                                        Width="120"/>
                    <DataGridTextColumn Header="CONFIDENCE %"
                                        Binding="{Binding Confidence}"
                                        Width="100"/>
                    <DataGridTextColumn Header="TEMP °C"
                                        Binding="{Binding Temperature}"
                                        Width="90"/>
                    <DataGridTextColumn Header="GRAVITY"
                                        Binding="{Binding GravityLevel}"
                                        Width="90"/>
                    <DataGridTextColumn Header="VIBRATION"
                                        Binding="{Binding MechanicalVibration}"
                                        Width="90"/>
                    <DataGridTextColumn Header="EFFICIENCY"
                                        Binding="{Binding ExpeditionEfficiencyScore}"
                                        Width="90"/>
                    <DataGridTextColumn Header="RECOMMENDATION"
                                        Binding="{Binding RecommendedAction}"
                                        Width="200"/>
                    <DataGridTextColumn Header="CAPTURE DATE"
                                        Binding="{Binding CaptureDate}"
                                        Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
